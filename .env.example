# Copy to .env and fill in. NEVER commit the real .env.

# Monero <-> WATTx bridge
WXMR_TOKEN_ADDRESS=
BRIDGE_CONTRACT_ADDRESS=
ALTCOINCHAIN_RPC_URL=
MONERO_WALLET_RPC_URL=
MONERO_NODE_RPC_URL=
BRIDGE_OPERATOR_PRIVATE_KEY=

# Optional: override node fleet host / per-coin endpoints (see src/config/nodeEndpoints.ts)
# VITE_ORACLE_HOST=

# --- In-browser kdf DEX engine ---
# Private WATTx liquidity netid (must match the seed node).
VITE_MM2_NETID=42
# Comma-separated seed node hostnames or IPv4s (bare names — kdf's RelayAddress
# rejects multiaddrs). The browser dials /dns/<host>/tcp/<netid-wss-port>/wss —
# port 7975 for netid 42 — so the seed must serve real TLS there (wss_certs).
# Example: kdf-seed.wattxchange.app
VITE_MM2_SEEDNODES=
# Set to true to POST to a native kdf daemon (Electron/desktop) instead of WASM.
VITE_MM2_NATIVE=false
